// alloy/config.alloy
// ─────────────────────────────────────────────────────────────────────────────
// Grafana Alloy starter configuration for Hermes
//
// What this does:
//   1. Scrapes Hermes' Prometheus /metrics endpoint every 15 s and
//      remote-writes the data to a Prometheus-compatible backend.
//   2. Discovers hermes-scheduler and hermes-api Docker containers,
//      tails their stdout/stderr, and forwards log lines to Loki.
//
// Environment variables consumed by this config:
//
//   PROMETHEUS_REMOTE_WRITE_URL  (required for metrics scraping)
//     Full remote_write URL, e.g.:
//       http://prometheus:9090/api/v1/write       — self-hosted Prometheus
//       http://mimir:9009/api/v1/push             — self-hosted Grafana Mimir
//       https://<id>.grafana.net/api/prom/push    — Grafana Cloud
//
//   LOKI_PUSH_URL  (required for log shipping)
//     Full Loki push URL, e.g.:
//       http://loki:3100/loki/api/v1/push         — self-hosted Loki
//       https://<id>.grafana.net/loki/api/v1/push — Grafana Cloud
//
//   HERMES_METRICS_ADDRESS  (optional, default: hermes-scheduler:8000)
//     host:port of the Hermes Prometheus /metrics endpoint.
//
//   ALLOY_LOG_LEVEL  (optional, default: info)
//     Log verbosity for the Alloy agent: debug | info | warn | error
//
// Quick start:
//   docker compose --profile alloy up -d
// ─────────────────────────────────────────────────────────────────────────────

logging {
  level  = coalesce(env("ALLOY_LOG_LEVEL"), "info")
  format = "logfmt"
}

// ── 1. Prometheus metrics ─────────────────────────────────────────────────────

prometheus.scrape "hermes_metrics" {
  targets = [
    {
      __address__ = coalesce(env("HERMES_METRICS_ADDRESS"), "hermes-scheduler:8000"),
      job         = "hermes",
    },
  ]

  // Scrape every 15 s — align this with your Prometheus/Mimir retention settings.
  scrape_interval = 15s
  metrics_path    = "/metrics"

  forward_to = [prometheus.remote_write.default.receiver]
}

prometheus.remote_write "default" {
  endpoint {
    url = env("PROMETHEUS_REMOTE_WRITE_URL")
  }
}

// ── 2. Container log collection ───────────────────────────────────────────────

// Discover the two Hermes containers by name.
discovery.docker "hermes_containers" {
  host = "unix:///var/run/docker.sock"

  filter {
    name   = "name"
    values = ["hermes-scheduler", "hermes-api"]
  }
}

// Relabel Docker metadata into human-readable Loki stream labels.
discovery.relabel "hermes_containers" {
  targets = discovery.docker.hermes_containers.targets

  // Strip the leading "/" from the container name (Docker prepends it).
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  // Keep the image reference so log queries can filter by image version.
  rule {
    source_labels = ["__meta_docker_container_image"]
    target_label  = "image"
  }

  // Tag every log line with job="hermes" for consistent LogQL queries.
  rule {
    replacement  = "hermes"
    target_label = "job"
  }
}

// Tail container stdout/stderr via the Docker daemon socket.
// Forward through the JSON parsing pipeline before writing to Loki.
loki.source.docker "hermes_logs" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.hermes_containers.output
  forward_to = [loki.process.parse_json_logs.receiver]
}

// Parse structured log fields when LOG_FORMAT=json is set on the Hermes containers.
// Lines that are not valid JSON (e.g. plain-text format) pass through unchanged.
loki.process "parse_json_logs" {
  // Extract "level", "logger", and "message" fields from JSON log lines.
  stage.json {
    expressions = {
      level   = "level",
      logger  = "logger",
      message = "message",
    }
  }

  // Promote the log level as a Loki stream label for efficient filtering
  // (e.g. {job="hermes", level="ERROR"}).  Only a small number of distinct
  // values so cardinality stays bounded.
  stage.labels {
    values = {
      level = "level",
    }
  }

  forward_to = [loki.write.default.receiver]
}

// Ship collected log lines to Loki.
loki.write "default" {
  endpoint {
    url = env("LOKI_PUSH_URL")
  }
}
