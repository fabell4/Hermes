# .env.example
# Copy this file to .env and fill in the values
# cp .env.example .env

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
# Log output format for stdout and logs/hermes.log.
# "text" — human-readable (default)
# "json" — single-line JSON per log record; recommended when using Grafana Alloy
#          so the loki.process pipeline can extract structured fields.
#          All exporters (CSV, SQLite, Prometheus, Loki direct-push) are unaffected.
# LOG_FORMAT=text

# --- Timezone ---
# IANA timezone name. Controls log timestamps inside the container.
# See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=UTC

# --- Scheduler ---
SPEEDTEST_INTERVAL_MINUTES=60
RUN_ON_STARTUP=true

# --- Speed Test Providers ---
# Ordered, comma-separated chain of test providers to try in sequence.
# The primary provider is retried once on failure before falling back to the next.
# Values: ookla (default), ndt7
# Example fallback chain: SPEEDTEST_PROVIDERS=ookla,ndt7
# SPEEDTEST_PROVIDERS=ookla

# Pin Ookla tests to a specific server (omit for automatic nearest-server selection).
# Find server IDs at: https://www.speedtest.net/speedtest-servers.php
# SPEEDTEST_SERVER_ID=

# --- Exporters ---
# Comma-separated list of exporters to enable on startup
# Available: csv, prometheus, loki, sqlite
ENABLED_EXPORTERS=csv

# --- CSV Exporter ---
CSV_LOG_PATH=logs/results.csv
# CSV_MAX_ROWS=1000        # Maximum number of rows to keep (oldest removed first). 0 = unlimited.
# CSV_RETENTION_DAYS=90   # Delete rows older than this many days. 0 = unlimited.

# --- SQLite Exporter ---
SQLITE_DB_PATH=data/hermes.db
# SQLITE_MAX_ROWS=5000     # Maximum number of rows to keep (oldest removed first). 0 = unlimited.
# SQLITE_RETENTION_DAYS=90 # Delete rows older than this many days. 0 = unlimited.

# --- Prometheus Exporter ---
# Port the /metrics HTTP server listens on inside the container.
# Must match the port mapping in docker-compose.yml.
# PROMETHEUS_PORT=8000

# --- Loki Exporter ---
# Full push URL for your Loki instance.
# When running alongside a Grafana stack, use the service name: http://loki:3100
# LOKI_URL=http://loki:3100
# LOKI_JOB_LABEL=hermes_speedtest

# --- InfluxDB Exporter ---
# Enable by adding "influxdb" to ENABLED_EXPORTERS.
# Base URL of your InfluxDB v2 instance.
# INFLUXDB_URL=https://influxdb.example.com:8086
# API token with write permission on the target bucket.
# INFLUXDB_TOKEN=my-influxdb-api-token
# Organisation name or ID (default: hermes).
# INFLUXDB_ORG=hermes
# Destination bucket name (default: speedtest).
# INFLUXDB_BUCKET=speedtest
# HTTP request timeout in milliseconds (default: 10000).
# INFLUXDB_TIMEOUT_MS=10000

# --- API / UI Port (docker-compose only) ---
# Host port to expose the FastAPI + React frontend on.
# API_PORT=8080

# --- Authentication ---
# When set, all write endpoints (POST /api/trigger, PUT /api/config) require
# an X-Api-Key header with this value. Leave unset to disable auth.
# Use a strong random value, e.g.: openssl rand -hex 32
API_KEY=

# Maximum write requests per API key per 60-second window. 0 = unlimited.
RATE_LIMIT_PER_MINUTE=60

# --- Alerting ---
# Alerting is disabled by default. Set threshold > 0 to enable.
# Number of consecutive failures before sending an alert.
# ALERT_FAILURE_THRESHOLD=0

# Minimum minutes between alerts (to prevent spam).
# ALERT_COOLDOWN_MINUTES=60

# NOTE: Alert provider settings can be configured in TWO ways:
# 1. Environment variables (below) - Set BEFORE first run, requires app restart
# 2. UI Settings page - Saves to data/runtime_config.json, takes precedence
#
# If you configure via env vars, those values will appear in the UI on first load.
# Once you save settings in the UI, those values override the env vars.
# Remove the # to uncomment and set your actual values.

# --- Webhook Alerts ---
# POST alerts to a custom webhook URL (JSON payload).
# ALERT_WEBHOOK_URL=https://your-webhook.example.com/alerts

# --- Gotify Alerts ---
# Push notifications via Gotify (https://gotify.net)
# ALERT_GOTIFY_URL=https://gotify.example.com
# ALERT_GOTIFY_TOKEN=your_app_token
# ALERT_GOTIFY_PRIORITY=5

# --- ntfy Alerts ---
# Push notifications via ntfy (https://ntfy.sh)
# ALERT_NTFY_URL=https://ntfy.sh
# ALERT_NTFY_TOPIC=your_topic_name
# ALERT_NTFY_TOKEN=tk_xxxxxxxxxxxxxx
# ALERT_NTFY_PRIORITY=3
# ALERT_NTFY_TAGS=warning,rotating_light

# --- Apprise Alerts ---
# Multi-service notifications via Apprise API (https://github.com/caronc/apprise-api)
# Requires separate Apprise API container/service
# URL format: {base_url}/notify/{config_id} for persistent config, or {base_url} for stateless mode
# Example with persistent config: https://apprise.greenflametech.net/notify/myconfig
# ALERT_APPRISE_URL=https://apprise.greenflametech.net/notify/myconfig

# --- SLA Monitoring ---
# Set thresholds to flag results that fall outside acceptable ranges.
# A result is marked sla_ok=false when any enabled threshold is breached.
# Leave unset (or 0) to disable individual checks.
# SLA_DOWNLOAD_MBPS=50      # Minimum acceptable download speed in Mbps.
# SLA_UPLOAD_MBPS=10        # Minimum acceptable upload speed in Mbps.
# SLA_PING_MS_MAX=50        # Maximum acceptable ping latency in ms.
# SLA_PACKET_LOSS_MAX_PCT=1 # Maximum acceptable packet loss percentage.

# --- Grafana Alloy Agent (optional) ---
# Enable with: docker compose --profile alloy up -d
# See docs/alloy.md for setup instructions.
#
# Full remote_write URL for Prometheus metrics ingestion.
# Self-hosted Prometheus:  http://prometheus:9090/api/v1/write
# Self-hosted Mimir:       http://mimir:9009/api/v1/push
# Grafana Cloud:           https://<id>.grafana.net/api/prom/push
# PROMETHEUS_REMOTE_WRITE_URL=http://prometheus:9090/api/v1/write
#
# Full Loki push URL for container log ingestion.
# Self-hosted Loki:    http://loki:3100/loki/api/v1/push
# Grafana Cloud:       https://<id>.grafana.net/loki/api/v1/push
# LOKI_PUSH_URL=http://loki:3100/loki/api/v1/push
#
# Override the host:port Alloy scrapes for Prometheus metrics (default: hermes-scheduler:8000).
# HERMES_METRICS_ADDRESS=hermes-scheduler:8000
#
# Log verbosity for the Alloy agent itself: debug | info | warn | error
# ALLOY_LOG_LEVEL=info

# --- Outage Detection ---
# Comma-separated list of host:port TCP probe endpoints.
# A majority-vote quorum must fail for a round to count as a failure.
# Recommended defaults use well-known public DNS resolvers (Cloudflare, Google, Quad9).
# OUTAGE_PROBE_HOSTS=1.1.1.1:53,8.8.8.8:53,9.9.9.9:53
# OUTAGE_PROBE_TIMEOUT=3
# OUTAGE_PROBE_FAILURE_THRESHOLD=2
# OUTAGE_PROBE_QUORUM=2