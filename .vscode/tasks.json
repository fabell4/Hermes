{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Hermes",
			"type": "shell",
			"command": "C:/Users/psywa/AppData/Local/Programs/Python/Python313/python.exe -m src.main",
			"group": "build"
		},
		{
			"label": "Run Hermes UI",
			"type": "shell",
			"command": "c:/Users/psywa/source/repos/projects/Hermes/.venv/Scripts/python.exe",
			"args": [
				"-m",
				"streamlit",
				"run",
				"src/streamlit_app.py",
				"--server.port",
				"8501"
			],
			"isBackground": true,
			"group": "build"
		},
		{
			"label": "Run Hermes API",
			"type": "shell",
			"command": "c:/Users/psywa/source/repos/projects/Hermes/.venv/Scripts/python.exe",
			"args": [
				"-m",
				"uvicorn",
				"src.api.main:app",
				"--port",
				"8080",
				"--reload"
			],
			"isBackground": true,
			"group": "build",
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			}
		},
		{
			"label": "Run Hermes Frontend (dev)",
			"type": "shell",
			"command": "npm",
			"args": ["run", "dev"],
			"options": {
				"cwd": "${workspaceFolder}/frontend"
			},
			"isBackground": true,
			"group": "build",
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			}
		},
		{
			"label": "Stop Hermes UI",
			"type": "shell",
			"command": "pwsh",
			"args": [
				"-NoProfile",
				"-Command",
				"$pids = Get-NetTCPConnection -LocalPort 8501 -State Listen -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess -Unique; if ($pids) { $pids | ForEach-Object { Stop-Process -Id $_ -Force }; Write-Host 'Stopped Hermes UI.' } else { Write-Host 'Hermes UI is not running.' }"
			],
			"group": "build"
		},
		{
			"label": "Serve Docs (Jekyll)",
			"type": "shell",
			"command": "bundle exec jekyll serve --port 4001 --livereload",
			"options": {
				"cwd": "${workspaceFolder}/docs"
			},
			"isBackground": true,
			"group": "build",
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true
			},
			"problemMatcher": {
				"owner": "jekyll",
				"pattern": {
					"regexp": "^.*$",
					"message": 1
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "Generating\\.\\.\\.",
					"endsPattern": "Server running\\.\\.\\."
				}
			}
		},
		{
			"label": "Build Docs (Jekyll)",
			"type": "shell",
			"command": "bundle exec jekyll build",
			"options": {
				"cwd": "${workspaceFolder}/docs"
			},
			"group": "build",
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true
			},
			"problemMatcher": []
		}
	]
}